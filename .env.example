# Discord bot credentials (Discord Developer Portal -> your application)
DISCORD_TOKEN=
CLIENT_ID=
# Optional: set this to your server's ID for instant command deployment while testing.
# Leave blank to deploy commands globally (takes up to ~1 hour to propagate).
GUILD_ID=

# Spotify credentials (Spotify Developer Dashboard -> your app)
# Needed to resolve Spotify links into playable tracks (metadata only,
# actual audio is streamed from YouTube — see README).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Must exactly match a Redirect URI configured on your Spotify app.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
FFMPEG_PATH=
